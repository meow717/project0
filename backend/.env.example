# ------------------------------------------------------------------ #
# Copy to `.env` for local prod-like runs. In dev (config.settings.dev)
# almost nothing here is required — SQLite + local storage are defaults.
# In production (config.settings.prod):
#   REQUIRED:  DJANGO_SETTINGS_MODULE, DJANGO_SECRET_KEY, DJANGO_DEBUG,
#              DJANGO_ALLOWED_HOSTS, DATABASE_URL
#   OPTIONAL:  REDIS_URL (falls back to local memory cache),
#              S3_* (falls back to local disk storage),
#              CSRF_TRUSTED_ORIGINS, CORS_ALLOWED_ORIGINS
# On Render, use the included render.yaml blueprint (New + -> Blueprint).
# ------------------------------------------------------------------ #

# Which settings module to load (dev | prod)
DJANGO_SETTINGS_MODULE=config.settings.prod

# Default admin superuser (auto-created on init; password re-applied each boot)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrator

# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_TIME_ZONE=UTC

# Database (prod) — django-environ DATABASE_URL form
DATABASE_URL=postgres://karkh:karkh@db:5432/karkh
# Used by the bundled postgres service in docker-compose.yml
POSTGRES_DB=karkh
POSTGRES_USER=karkh
POSTGRES_PASSWORD=karkh

# Cache / Redis (prod required; dev optional)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=karkh-backend

# Object storage — MinIO (prod). The bundled minio service uses these too.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=karkh-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_QUERYSTRING_AUTH=True
S3_URL_PROTOCOL=http:

# CORS — the Next.js frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gunicorn
GUNICORN_WORKERS=3

# SmartQueue feature settings (defaults match dev; override in prod)
ALERT_LEAD_SECONDS=900
LIVE_SNAPSHOT_TTL_SECONDS=5
DEFAULT_SERVICE_DURATION_SEC=600

# Email — SMTP in prod; dev uses the console backend (no vars needed)
# Keys match the EMAIL_* settings in config/settings/base.py
DEFAULT_FROM_EMAIL=SmartQueue <no-reply@your-domain.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-domain.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# SMS — "console" logs messages (dev); "provider" selects the real-provider stub (prod)
# Keys match the SMS_* settings in config/settings/base.py
SMS_PROVIDER=console
SMS_FROM=
SMS_API_KEY=
